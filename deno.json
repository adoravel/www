{
	"minimumDependencyAge": "0",
	"tasks": {
		"start": "ENV=production deno run --env-file --quiet -P=default ./src/main.ts",
		"dev": "deno run --env-file --quiet -P=default --watch ./src/main.ts"
	},
	"permissions": {
		"default": {
			"net": true,
			"read": true,
			"run": true,
			"env": true,
			"write": true,
			"sys": true,
			"ffi": true
		}
	},
	"fmt": {
		"useTabs": true,
		"semiColons": true,
		"lineWidth": 90
	},
	"lint": {
		"rules": {
			"exclude": ["no-explicit-any", "no-window"]
		}
	},
	"compilerOptions": {
		"jsx": "react-jsx",
		"jsxImportSource": "@404/aether",
		"lib": ["deno.ns", "dom", "dom.iterable"]
	},
	"imports": {
		"@404/aether": "jsr:@404/aether@^1.3.0",
		"@fontsource/public-sans": "npm:@fontsource/public-sans@^5.3.0",
		"@pdf-lib/fontkit": "npm:@pdf-lib/fontkit@^1.1.1",
		"@july/snarl": "jsr:@july/snarl@^2.3.0",
		"@markdoc/markdoc": "npm:@markdoc/markdoc@^0.5.10",
		"blurhash": "npm:blurhash@^2.0.5",
		"sharp": "npm:sharp@^0.35.5",
		"@atcute/identity-resolver": "npm:@atcute/identity-resolver@^2.0.2",
		"@atcute/lexicons": "npm:@atcute/lexicons@^2.1.1",
		"@atcute/oauth-node-client": "npm:@atcute/oauth-node-client@^2.0.1",
		"@std/crypto": "jsr:@std/crypto@^1.1.0",
		"@std/encoding": "jsr:@std/encoding@^1.0.11",
		"@std/path": "jsr:@std/path@^1.1.6",
		"@std/yaml": "jsr:@std/yaml@^1.3.0",
		"pdf-lib": "npm:pdf-lib@^1.17.1",
		"~/": "./src/",
		"~/tokens": "./src/tokens/mod.ts"
	},
	"exclude": ["data"]
}
